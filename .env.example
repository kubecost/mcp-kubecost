## for local development, create a port-forward into the kubecost frontend on 9090
## if running the MCP inside a container "host.docker.internal" allows the container to access kubecost
KUBECOST_BASE_URL=http://localhost:9090

## Base path prefix for all Kubecost API calls (default: /model). If targeting aggregator directly, remove "model"
KUBECOST_API_BASE_PATH=/model

## If using SAML/RBAC, the MCP server will require an API key. This is sent to Kubecost as an "X-API-KEY" request header.
## Individual MCP clients may send its own X-API-KEY header, or a global environment variable can be used.
## The header takes precedence over the environment variable when both are present.
# KUBECOST_API_KEY=

## Reject HTTP requests that arrive without an X-API-KEY header. STDIO is never gated,
## since a STDIO client has no way to send one.
# REQUIRE_CLIENT_API_KEY=false

## Defaults — uncomment to override
## HTTP mode always sets FASTMCP_ENABLE_RICH_LOGGING=false (ANSI codes break log scrapers).
## The server always disables FASTMCP_SHOW_SERVER_BANNER (FastMCP's own default is true).
# REQUEST_TIMEOUT_SECONDS=15
# REQUEST_RETRY_COUNT=2
# MCP_RATE_LIMIT_REQUESTS_PER_SECOND=10
# MCP_RATE_LIMIT_BURST_CAPACITY=20
# MCP_MAX_CONCURRENT_TOOL_CALLS=10
# DEFAULT_WINDOW=15d
# FASTMCP_LOG_LEVEL=INFO
# FASTMCP_ENABLE_RICH_LOGGING=true
# USE_CAC_VIEWS=false
# KUBECOST_SSL_VERIFY=true
## SSL/TLS — set SSL_CA_BUNDLE to use a custom CA (implies verify=true)
# SSL_CA_BUNDLE=/etc/ssl/certs/my-ca.crt

## OIDC Authentication (HTTP transport only)
## AUTH_MODE controls how the MCP HTTP endpoint is protected:
##   none    — no auth (default)
##   open    — no auth; Helm uses this to acknowledge an exposed route (runtime same as none)
##   oidc    — require a valid OIDC token via FastMCP's OIDCProxy
##   api_key — require X-API-KEY header (same as REQUIRE_CLIENT_API_KEY=true)
## To require OIDC and a per-request X-API-KEY, set AUTH_MODE=oidc and REQUIRE_CLIENT_API_KEY=true.
# AUTH_MODE=none

## OIDC provider settings (required when AUTH_MODE=oidc)
## OIDC_ISSUER_URL is the provider's .well-known/openid-configuration URL.
## Example:
## https://{domain}/.well-known/openid-configuration
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUDIENCE=
## Durable OAuth storage. FastMCP registrations and tokens are encrypted before
## the built-in FileTreeStore writes them here. The Helm chart fixes this to a
## mandatory PVC at /var/lib/mcp-kubecost/oauth; local runs may override it.
# For local OIDC development, choose an absolute directory your user can write.
## Must be a nested absolute path with no '..' segments — the server deletes this
## directory on startup when OIDC_STORAGE_ENCRYPTION_KEY is unset, so '/' and
## top-level directories like '/var' are rejected.
# OIDC_STORAGE_PATH=/var/lib/mcp-kubecost/oauth
## Optional — auto-generated as an ephemeral key at startup when unset.
## Set this explicitly in production to ensure token consistency across restarts.
## Minimum 32 characters.
# OIDC_JWT_SIGNING_KEY=
## Optional — auto-generated as an ephemeral Fernet key at startup when unset.
## Set this explicitly in production to preserve OAuth sessions across restarts.
## Generate with:
## .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OIDC_STORAGE_ENCRYPTION_KEY=
## Public FastMCP authorization-server base URL. This is not the upstream IdP
## and is deliberately separate from the MCP protected-resource URL. On a shared
## Kubecost hostname, reserve /oauth/mcp for FastMCP's /authorize, /token,
## /register, /consent, and callback routes. The reverse proxy strips /oauth/mcp
## before forwarding those requests to this server.
# OIDC_BASE_URL=https://kubecost.example.com/oauth/mcp
## Public base URL that hosts MCP_HTTP_PATH. FastMCP appends /mcp by default,
## producing the protected resource identifier https://kubecost.example.com/mcp.
# OIDC_RESOURCE_BASE_URL=https://kubecost.example.com
## Callback relative to OIDC_BASE_URL. Register
## https://kubecost.example.com/oauth/mcp/callback exactly at the upstream IdP.
# OIDC_REDIRECT_PATH=/callback
## Comma-separated OAuth scopes to request (default: openid,profile)
# OIDC_REQUIRED_SCOPES=openid,profile
## Optional JSON array of allowed downstream MCP-client redirect URI patterns.
## Leave unset for the Open default, which supports standards-compatible DCR/CIMD
## clients. This is not the upstream IdP callback allowlist. Set it only for an
## enterprise Restricted posture, after inspecting "Client registered with
## redirect_uri" log messages for the callbacks your clients use.
# OIDC_ALLOWED_CLIENT_REDIRECT_URIS=["http://localhost:*", "https://client.example/callback"]

## FastMCP Host/Origin protection. "auto" protects localhost and turns on
## explicit validation whenever either JSON allowlist is configured. Use true
## with allowlists for strict validation on every bind.
# FASTMCP_HTTP_HOST_ORIGIN_PROTECTION=auto
## Examples for an ingress:
# FASTMCP_HTTP_ALLOWED_HOSTS=["mcp.example.com"]
# FASTMCP_HTTP_ALLOWED_ORIGINS=["https://app.example.com"]

## Route the MCP endpoint is served on (passed to `fastmcp run --path`).
## Default /mcp. This is independent of OIDC_BASE_URL. Read by the container
## entrypoint (mcp-kubecost-http) before the server starts, so running
## `fastmcp run config/fastmcp-http.json` directly ignores it — pass --path yourself.
# MCP_HTTP_PATH=/mcp

## Telemetry — off disables the OTEL SDK wrapper; any other value (e.g. native) enables
## opentelemetry-instrument. Set OTEL_EXPORTER_OTLP_ENDPOINT when enabling.
# FASTMCP_TELEMETRY_MODE=off
# OTEL_SERVICE_NAME=mcp-kubecost
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
## opentelemetry-distro enables traces, metrics AND logs by default. Traces-only backends
## (Tempo, Jaeger) reject the other two with StatusCode.UNIMPLEMENTED — turn them off there.
# OTEL_METRICS_EXPORTER=none
# OTEL_LOGS_EXPORTER=none
