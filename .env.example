# "host.docker.internal" allows the container to access kubecost that has an open port-forward to the frontend on 9090:
KUBECOST_BASE_URL=http://host.docker.internal:9090
# Base path prefix for all Kubecost API calls (default: /model). Change only if Kubecost is served under a custom prefix.
KUBECOST_API_BASE_PATH=/model
KUBECOST_API_KEY=
REQUEST_TIMEOUT_SECONDS=15
REQUEST_RETRY_COUNT=2
DEFAULT_WINDOW=15d
FASTMCP_SHOW_SERVER_BANNER=false
FASTMCP_LOG_LEVEL=INFO

# CAC Views — when true, appends viewId=0 to every Kubecost API call
USE_CAC_VIEWS=false

# SSL — set KUBECOST_SSL_VERIFY=false to skip cert validation, or SSL_CA_BUNDLE=/path/to/ca.crt to use a custom CA
KUBECOST_SSL_VERIFY=true
#SSL_CA_BUNDLE=/etc/ssl/certs/my-ca.crt

# Telemetry — off disables the OTEL SDK wrapper; any other value (e.g. native) enables
# opentelemetry-instrument. Set OTEL_EXPORTER_OTLP_ENDPOINT when enabling.
FASTMCP_TELEMETRY_MODE=off
OTEL_SERVICE_NAME=mcp-kubecost
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
