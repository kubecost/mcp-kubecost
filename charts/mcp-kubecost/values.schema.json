{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean" },
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "imageRegistry": { "type": "string" },
        "defaultStorageClass": { "type": "string" },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": { "name": { "type": "string", "minLength": 1 } },
                "required": ["name"]
              }
            ]
          }
        },
        "annotations": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "additionalLabels": { "type": "object" }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "reloadOnConfigChange": { "type": "boolean" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "automountServiceAccountToken": { "type": "boolean" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "allowUnauthenticatedExposure": { "type": "boolean" },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "group": { "type": "string" },
              "kind": { "type": "string" },
              "name": { "type": "string", "minLength": 1 },
              "namespace": { "type": "string" },
              "sectionName": { "type": "string" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            },
            "required": ["name"]
          }
        },
        "hostnames": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "host": { "type": "string", "minLength": 1 } },
            "required": ["host"]
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": { "type": "string", "minLength": 1 },
              "hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "required": ["secretName", "hosts"]
          }
        }
      }
    },
    "resources": { "type": "object" },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] }
        },
        "size": { "type": "string", "minLength": 1 },
        "annotations": { "type": "object" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "strategy": { "type": "object" },
        "annotations": { "type": "object" },
        "labels": { "type": "object" },
        "selector": { "type": "object" }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "pattern": "^/" },
        "startup": { "type": "object" },
        "readiness": { "type": "object" },
        "liveness": { "type": "object" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kubecostApiBaseUrl": { "type": "string", "pattern": "^https?://[^:/?#]+$" },
        "kubecostApiPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "kubecostApiBasePath": { "type": "string", "pattern": "^/" },
        "kubecostApiKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": { "type": "string" },
            "existingSecret": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "requireClientApiKey": { "type": "boolean" },
        "requestTimeoutSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "requestRetryCount": { "type": "integer", "minimum": 0 },
        "rateLimitRequestsPerSecond": { "type": "number", "exclusiveMinimum": 0 },
        "rateLimitBurstCapacity": { "type": "integer", "minimum": 1 },
        "maxConcurrentToolCalls": { "type": "integer", "minimum": 1 },
        "defaultWindow": { "type": "string", "minLength": 1 },
        "logLevel": { "type": "string", "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL", "debug", "info", "warning", "error", "critical"] },
        "useCacViews": { "type": "boolean" },
        "legacyTextContent": { "type": "boolean" },
        "externalUrl": { "type": "string", "pattern": "^$|^https://[^/?#]+/?$" },
        "fastmcpHttpHostOriginProtection": { "oneOf": [{ "type": "boolean" }, { "type": "string", "enum": ["auto"] }] },
        "fastmcpHttpAllowedHosts": { "type": "string" },
        "fastmcpHttpAllowedOrigins": { "type": "string" },
        "mcpServerName": { "type": "string", "minLength": 1 },
        "telemetryMode": { "type": "string", "minLength": 1 },
        "otelServiceName": { "type": "string", "minLength": 1 },
        "otelExporterOtlpEndpoint": { "type": "string" },
        "otelMetricsExporter": { "type": "string", "minLength": 1 },
        "otelLogsExporter": { "type": "string", "minLength": 1 },
        "ssl": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "verify": { "type": "boolean" },
            "caBundle": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingSecret": { "type": "string" },
                "key": { "type": "string", "minLength": 1 },
                "mountPath": { "type": "string", "pattern": "^/" }
              }
            }
          }
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "issuerUrl": { "type": "string" },
            "audience": { "type": "string" },
            "requiredScopes": { "type": "string" },
            "allowedClientRedirectUris": { "type": "string" },
            "clientID": { "type": "string" },
            "clientSecret": { "type": "string" },
            "jwtSigningKey": { "type": "string" },
            "storageEncryptionKey": { "type": "string" },
            "existingSecret": { "type": "string" }
          }
        }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
